# 旧Botと受信実験を停止してから1にする。同じ端末設定・認証を再利用する。
LINE_OLD_BOT_STOPPED=0
LINE_DEVICE=DESKTOPWIN
LINE_STORAGE_FILE=storage/auth.json
CORE_DATABASE_PATH=storage/core.sqlite
# 48時間の重複判定IDの件数上限。本文履歴は保持しない。SQLiteのbyte上限は別。
CORE_MAX_RETAINED_EVENTS=131072
# 同梱txtと検索snapshot。起動時に読み込む。変更後は再起動・再配備する。
CONTENT_DIRECTORY=content
SEARCH_DATA_PATH=data/search/catalog.json
# 動画生成のFFmpeg絶対path。Linuxコンテナでは未指定時/usr/bin/ffmpeg。
FFMPEG_PATH=
# 保存済み.authがある場合は不要。認証値をGitへcommitしない。
LINE_AUTH_TOKEN=
# 全短時間RPCの共通上限。LINE側の安全な制限値を表す設定ではない。
LINE_API_CONCURRENCY=2
LINE_API_INTERVAL_MS=250
PORT=3000
