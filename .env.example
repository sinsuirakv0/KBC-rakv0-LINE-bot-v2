# 旧Botと受信実験を停止してから1にする。同じ端末設定・認証を再利用する。
LINE_OLD_BOT_STOPPED=0
LINE_DEVICE=DESKTOPWIN
LINE_STORAGE_FILE=storage/auth.json
CORE_DATABASE_PATH=storage/core.sqlite
# 旧permissions.jsonのSQUARE権限だけを読む機密ファイル。未指定ならBOT管理権限なし。
# 設定変更後は再起動する。認証や実MIDを公開Gitへcommitしない。
BOT_PERMISSIONS_PATH=
# 初回だけ取り込む旧OC管理設定。新版の保存済み設定は上書きしない。
LEGACY_OC_SETTINGS_PATH=
# 48時間の重複判定IDの件数上限。本文履歴は保持しない。SQLiteのbyte上限は別。
CORE_MAX_RETAINED_EVENTS=131072
# txtは起動時に読み込む。検索データは公開mainを90秒ごとに確認し、2分で失効する。
CONTENT_DIRECTORY=content
SEARCH_DATA_PATH=storage/search/catalog.json
# 動画生成のFFmpeg絶対path。Linuxコンテナでは未指定時/usr/bin/ffmpeg。
FFMPEG_PATH=
# motion生成失敗時のDiscord代行。両方設定した場合だけ有効。
# URLはHTTPSの/motion-jobsまで指定（ローカル検証のみlocalhost等のHTTP可）。
# 認証キーは32〜256文字。Discord側MOTION_RENDER_SECRETと同じ値。
MOTION_REMOTE_URL=
MOTION_REMOTE_SECRET=
# 保存済み.authがある場合は不要。認証値をGitへcommitしない。
LINE_AUTH_TOKEN=
# 全短時間RPCの共通上限。LINE側の安全な制限値を表す設定ではない。
LINE_API_CONCURRENCY=2
LINE_API_INTERVAL_MS=250
# 既存の非公開データrepo。指定すると旧認証・設定を復元し、Coreを毎分暗号化退避する。
# GitHub障害中の未退避分はコンテナ交換で失われ得る。詳細はGITHUB_RECOVERY.md。
PUSH_SUBSCRIPTIONS_GITHUB_REPO=
PUSH_SUBSCRIPTIONS_GITHUB_TOKEN=
PUSH_SUBSCRIPTIONS_GITHUB_BRANCH=main
LINE_STORAGE_GITHUB_PATH=line-auth/storage.enc.json
LINE_STORAGE_BACKUP_KEY=
# 旧ログの変換Workflowが完了してから1。5分ごとに同じ4MiB追記先を更新する。
OC_LOGS_ENABLED=0
PORT=3000
